@startuml 02-use-case
' DOC-07 §7.4 — Use Case Diagram. UC IDs are traced to FR IDs in DOC-07 §7.4 table.
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F5F7FB
  BorderColor #3B5B92
}
title Use Case Diagram — KZ-RU Emotion Analysis Platform

actor "Analyst" as Analyst
actor "Administrator" as Admin
actor "External system\n(Integrator)" as Integrator
actor "ML Engineer" as MLEng

Admin -|> Analyst : <<inherits>>

rectangle "KZ-RU Emotion Analysis Platform" {
  usecase "UC-00 Log in" as UC00
  usecase "UC-01 Analyse a single text\n(FR-01, FR-02, FR-03)" as UC01
  usecase "UC-02 Upload batch file\n(FR-05)" as UC02
  usecase "UC-03 Map file columns\n(FR-06)" as UC03
  usecase "UC-04 Monitor batch progress\n(FR-07)" as UC04
  usecase "UC-05 View emotion dashboard\n(FR-09, FR-10, FR-11, FR-13)" as UC05
  usecase "UC-06 Browse & filter results\n(FR-08)" as UC06
  usecase "UC-07 Export report\n(FR-12)" as UC07
  usecase "UC-08 Manage batch history\n(FR-16)" as UC08
  usecase "UC-09 Correct predicted label\n(FR-19, Could)" as UC09
  usecase "UC-10 Manage API keys\n(FR-14, FR-17)" as UC10
  usecase "UC-11 Manage users & roles\n(FR-15, FR-17)" as UC11
  usecase "UC-12 View system status\n(FR-17, FR-18)" as UC12
  usecase "UC-13 Analyse text via API\n(FR-01, FR-14)" as UC13
  usecase "UC-14 Submit batch via API\n& fetch results (FR-05..FR-09)" as UC14
  usecase "UC-15 Train & evaluate model\n(MLR-01..MLR-06)" as UC15
  usecase "UC-16 Publish model version\n(MLR-07, FR-18)" as UC16
}

Analyst --> UC01
Analyst --> UC02
Analyst --> UC04
Analyst --> UC05
Analyst --> UC06
Analyst --> UC07
Analyst --> UC08
Analyst --> UC09

Admin --> UC10
Admin --> UC11
Admin --> UC12

Integrator --> UC13
Integrator --> UC14

MLEng --> UC15
MLEng --> UC16

UC02 ..> UC00 : <<include>>
UC05 ..> UC00 : <<include>>
UC10 ..> UC00 : <<include>>
UC03 .> UC02 : <<extend>>
UC02 ..> UC04 : <<include>>
UC06 .> UC05 : <<extend>>
UC07 .> UC05 : <<extend>>
UC09 .> UC06 : <<extend>>
UC16 ..> UC15 : <<include>>
@enduml
