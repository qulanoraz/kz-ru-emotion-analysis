# Copy to .env and replace placeholder values. Never commit .env (see .gitignore, NFR-07).

# ---- PostgreSQL ----
POSTGRES_DB=emotions
POSTGRES_USER=emotions
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://emotions:change-me@postgres:5432/emotions

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0

# ---- Backend API ----
APP_ENV=development
SECRET_KEY=change-me-long-random-string
API_RATE_LIMIT_PER_MIN=60
SESSION_TTL_HOURS=8
BATCH_MAX_FILE_MB=10
BATCH_MAX_ITEMS=50000
TEXT_MAX_CHARS=2000
RETENTION_DAYS=30
ML_SERVICE_URL=http://ml-service:8001
ML_SERVICE_TIMEOUT_S=5

# ---- ML inference service ----
ACTIVE_MODEL_VERSION=emotion-xlmr-kkru-v0.1.0
MODEL_DIR=/models
MAX_TOKENS=512
PREDICT_BATCH_SIZE=64

# ---- Web UI ----
VITE_API_BASE_URL=/api/v1
