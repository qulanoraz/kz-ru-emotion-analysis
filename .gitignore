# ============================================================
# KZ-RU Emotion Analysis — .gitignore
# ============================================================

# ---------- Secrets & environment ----------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# ---------- Jupyter ----------
.ipynb_checkpoints/
# Keep notebooks, but strip outputs before commit (nbstripout recommended)

# ---------- ML data & artifacts (never commit) ----------
ml/data/raw/*
ml/data/interim/*
ml/data/processed/*
!ml/data/raw/.gitkeep
!ml/data/interim/.gitkeep
!ml/data/processed/.gitkeep
!ml/data/README.md

ml/models/*
!ml/models/.gitkeep
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.ckpt
*.h5

# Experiment tracking
mlruns/
wandb/
runs/
lightning_logs/
outputs/
.cache/
hf_cache/

# Large or personal-data files anywhere
*.parquet
*.feather
*.zip
*.tar.gz
*.7z
uploads/
storage/

# Raw interview recordings (only anonymised notes are committed)
docs/evidence/interviews/*.mp3
docs/evidence/interviews/*.m4a
docs/evidence/interviews/*.wav
docs/evidence/interviews/raw/

# ---------- Node / frontend ----------
node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Databases ----------
*.sqlite
*.sqlite3
*.db
pgdata/
postgres-data/

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Logs ----------
logs/
*.log

# ---------- IDE / OS ----------
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------- Load testing reports ----------
backend/tests/load/reports/

# ---------- Local tools ----------
tools/*.jar
docs/pm/backlog-tables.md
